# 복사해서 .env 로 쓰세요 (.env 는 git 에 올라가지 않음)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# AI 채점 타임아웃(ms), 기본 10000
# AI_TIMEOUT_MS=10000

# 서버 포트 (PaaS 는 보통 자동 주입), 기본 3000
# PORT=3000

# schema.sql 의 앱 전용 계정 (운영에서는 비밀번호를 반드시 바꾸세요)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chiikawa_app
DB_PASSWORD=change-me
DB_NAME=chiikawa_study
